# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://qrmenu:qrmenu@db:5432/qr_menu_app

# Public base URL of the app (used for QR code links)
# In local dev with docker-compose this is typically http://localhost:3000
BASE_URL=http://localhost:3000

# S3-compatible object storage endpoint (MinIO in local dev).
# This value is also used as the base for public photo image URLs, so it
# must be reachable by both the app server AND end-user browsers.
# With docker-compose: add "127.0.0.1 minio" to /etc/hosts so the browser
# can resolve the minio hostname (port 9000 is exposed to the host).
S3_ENDPOINT=http://minio:9000

# S3 bucket name for photo uploads
BUCKET=qr-menu-photos

# S3 credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# S3 region (use "auto" for MinIO / non-AWS endpoints)
AWS_REGION=auto
