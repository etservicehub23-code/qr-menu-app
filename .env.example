# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://qrmenu:qrmenu@db:5432/qr_menu_app

# Public base URL of the app (used for QR code links and photo URLs)
# In local dev with docker-compose this is typically http://localhost:3000
BASE_URL=http://localhost:3000

# S3-compatible object storage endpoint (MinIO in local dev)
S3_ENDPOINT=http://minio:9000

# S3 bucket name for photo uploads
BUCKET=qr-menu-photos

# S3 credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# S3 region (use "auto" for MinIO / non-AWS endpoints)
AWS_REGION=auto
